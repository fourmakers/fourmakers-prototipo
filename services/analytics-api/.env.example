# Copiar para .env (não versionar)

PORT=3001
NODE_ENV=development

# GA4 (obrigatório para dados reais Firebase)
GA4_PROPERTY_ID=530562554
GCP_PROJECT_ID=fourmakers-app
BQ_DATASET=analytics_530562554
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/analytics-hub-reader.json

# BigQuery (Fase 2 — funis, environment, friction_error)
BQ_ENABLED=false
BQ_DATASET=

# Auth opcional (Bearer)
ANALYTICS_API_TOKEN=

# CORS (vírgulas)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://foursys-doug.github.io

# Cache em memória (ms)
CACHE_TTL_MS=900000

# Contentsquare (P1)
CONTENTSQUARE_API_KEY=
CONTENTSQUARE_SITE_ID=
CONTENTSQUARE_API_BASE_URL=https://api.contentsquare.com

# Modo demo sem credenciais GCP (só dev local)
DEMO_MODE=false
