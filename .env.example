# Analytics — consumo via BFF (services/analytics-api), NÃO GA4/BQ no browser
# Ver docs/ANALYTICS_FRONTEND_BFF_CONFIG.md

# --- Modo BFF (dados agregados reais quando API disponível) ---
# VITE_ANALYTICS_USE_MOCK=false
# VITE_ANALYTICS_FALLBACK_MOCK=true
# URL Cloud Run após deploy — ou vazio + npm run analytics-api:dev (proxy /analytics)
# VITE_ANALYTICS_API_BASE_URL=https://fourmakers-analytics-api-xxxxx.run.app

# --- Modo protótipo GitHub Pages (default sem .env.local) ---
# VITE_ANALYTICS_USE_MOCK=true

# Desactivar proxy Vite para /analytics (só se usar URL absoluta da API)
# VITE_ANALYTICS_PROXY_DISABLED=false

# Se API falhar, mostrar mocks em vez de erro
# VITE_ANALYTICS_FALLBACK_MOCK=true

# Bearer JWT (só local/CI — nunca commitar valor real)
# VITE_ANALYTICS_API_TOKEN=

# Metadados Firebase (do firebase_options.dart — projectId NÃO é GA4 Property ID)
# VITE_FIREBASE_PROJECT_ID=fourmakers-app
# VITE_FIREBASE_PROJECT_NUMBER=1076704618091
# VITE_GA4_PROPERTY_ID=530562554
# VITE_GA4_ANDROID_STREAM_ID=14319499513
# VITE_GA4_MEASUREMENT_ID=G-530562554
# VITE_BQ_DATASET=analytics_530562554
# VITE_FIREBASE_API_KEY=             # opcional; NÃO commitar — não lê relatórios no hub
