# Analytics API FourMakers (hub) — copiar para .env.local (não versionar secrets)
# Sem VITE_ANALYTICS_API_BASE_URL → usa mocks (protótipo GitHub Pages)

# URL da Analytics API (Cloud Run / backend) — OBRIGATÓRIO para dados reais
# VITE_ANALYTICS_API_BASE_URL=https://fourmakers-analytics-api.example.run.app

# false = tentar API; true = só mocks
# VITE_ANALYTICS_USE_MOCK=true

# Se API falhar, mostrar mocks em vez de erro
# VITE_ANALYTICS_FALLBACK_MOCK=true

# Bearer JWT (só local/CI — nunca commitar valor real)
# VITE_ANALYTICS_API_TOKEN=

# Metadados Firebase (do firebase_options.dart — projectId NÃO é GA4 Property ID)
# VITE_FIREBASE_PROJECT_ID=fourmakers-app
# VITE_FIREBASE_PROJECT_NUMBER=1076704618091
# VITE_GA4_PROPERTY_ID=              # pedir ao dev/data — numérico, ex. 123456789
# VITE_FIREBASE_API_KEY=             # opcional; NÃO commitar — não lê relatórios no hub
